# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
build/
*.local

# Environment. .env.example is committed on purpose.
.env
.env.*
!.env.example

# Test and coverage output
coverage/
.vitest/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db

# Blueprint generated local state. blueprint/.state/.gitignore also covers
# run.json, backups, and staging; this keeps them ignored from the root too.
blueprint/.state/run.json
blueprint/.state/backups/
blueprint/.state/staging/

# Captured SkySpy fixtures may contain a real host or token before scrubbing.
# Feature 3 commits scrubbed fixtures deliberately; nothing lands here by accident.
docs/fixtures/*.raw.json
