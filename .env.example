# Copy to .env and adjust. Every variable here is optional: with no .env file at
# all the app talks to the public OpenSky Network API anonymously.
#
# WARNING: every VITE_ variable is compiled into the browser bundle and is
# readable by anyone who loads the app. That is acceptable for local and
# trusted-network use only. A public deployment needs a backend proxy that
# holds the credentials server side.

# Optional. OpenSky REST base URL. Defaults to https://opensky-network.org/api.
VITE_OPENSKY_API_BASE=

# Optional. OpenSky OAuth2 token endpoint. Defaults to the public Keycloak realm.
VITE_OPENSKY_AUTH_URL=

# Optional. OpenSky API client credentials, created under your OpenSky account.
# Leave both unset for anonymous access, which OpenSky allows at 400 credits per
# day per IP instead of 4000. Setting one without the other is an error.
VITE_OPENSKY_CLIENT_ID=
VITE_OPENSKY_CLIENT_SECRET=

# Optional. Poll interval in milliseconds. Defaults to 30000, which is also the
# minimum: a bounded query costs one credit, so faster polling exhausts the
# daily budget before the day ends.
VITE_OPENSKY_POLL_MS=

# Optional. Absolute https URL of a MapLibre style.
# Defaults to the keyless CARTO Dark Matter style.
VITE_MAP_STYLE_URL=

# Optional. Initial map centre as "lat,lon". Defaults to "0,0".
VITE_DEFAULT_CENTER=52.3676,4.9041

# Optional. Initial map zoom, 0 to 22. Defaults to 6.
VITE_DEFAULT_ZOOM=7
