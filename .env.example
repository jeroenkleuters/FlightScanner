# Copy to .env and adjust. Every variable here is optional: with no .env file at
# all the proxy talks to the public OpenSky Network API anonymously.
#
# Two groups, and the split matters. VITE_ variables are compiled into the
# browser bundle and readable by anyone who loads the app. The unprefixed ones
# are read only by the proxy (src/server/env.ts) and never reach the client.

# ---------------------------------------------------------------------------
# Server only. Never VITE_ prefixed, never sent to the browser.
# ---------------------------------------------------------------------------

# Optional. OpenSky API client credentials, created under your OpenSky account.
# Leave both unset for anonymous access, which OpenSky allows at 400 credits per
# day per IP instead of 4000. Setting one without the other is an error, because
# it would silently downgrade to the smaller quota.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional. OpenSky REST base URL. Defaults to https://opensky-network.org/api.
OPENSKY_API_BASE=

# Optional. OpenSky OAuth2 token endpoint. Defaults to the public Keycloak realm.
OPENSKY_AUTH_URL=

# Point both of the two variables above at the dev-only mock feed to develop
# against a replayed snapshot instead of spending OpenSky credits:
#
#   OPENSKY_API_BASE=http://127.0.0.1:8787
#   OPENSKY_AUTH_URL=http://127.0.0.1:8787/token
#
# Run it with `npm run mock`. Credentials are irrelevant in mock mode. Blank
# both again to reach the real API: a .env left pointing at the mock is silent,
# because the app looks healthy while the data is a replay. See docs/mock-feed.md.

# ---------------------------------------------------------------------------
# Client. Compiled into the bundle, so nothing sensitive belongs here.
# ---------------------------------------------------------------------------

# Optional. Poll interval in milliseconds. Defaults to 30000, which is also the
# minimum: a bounded query costs one credit, so faster polling exhausts the
# daily budget before the day ends.
VITE_OPENSKY_POLL_MS=

# Optional. Absolute https URL of a MapLibre style.
# Defaults to the keyless CARTO Dark Matter style.
VITE_MAP_STYLE_URL=

# Optional. Initial map centre as "lat,lon". Defaults to "0,0".
VITE_DEFAULT_CENTER=52.3676,4.9041

# Optional. Initial map zoom, 0 to 22. Defaults to 6.
VITE_DEFAULT_ZOOM=7
